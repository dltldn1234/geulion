{
  "name": "geulion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A Korean-first general-purpose programming language.",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.0.0"
  },
  "scripts": {
    "build": "tsc --build",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --build --force --pretty false && tsc --noEmit --pretty false --project tsconfig.test.json",
    "test": "pnpm build && vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@geulion/ast": "workspace:*",
    "@geulion/cli": "workspace:*",
    "@geulion/codegen-js": "workspace:*",
    "@geulion/compiler": "workspace:*",
    "@geulion/lexer": "workspace:*",
    "@geulion/parser": "workspace:*",
    "@geulion/semantic": "workspace:*",
    "@types/node": "^24.0.0",
    "eslint": "^10.13.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
